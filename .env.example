# Create .env from this file and provide the key yourself.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest

MCP_URL=http://localhost:8001/mcp
SESSION_TTL_SECONDS=3600
CHAT_HISTORY_LIMIT=12
CHAT_MAX_TOKENS=2048

# How many companies in a batch analysis request may collect their MCP
# chapters concurrently (cheap; defaults to the max batch size).
BATCH_CHAPTER_CONCURRENCY=10
# How many OpenRouter calls (per-company + comparison summaries) may run
# concurrently in one batch request; tune to the account's rate limit.
BATCH_LLM_CONCURRENCY=3


# MongoDB container and seed
MONGO_IMAGE_TAG=7.0
MONGO_DATABASE=counterparties
MONGO_COLLECTION=reports
MONGO_READ_COLLECTION=counterparty_cards
MONGO_PORT=27017
FRONTEND_PORT=3000

# Used only when the API is started directly on the host.
# Docker Compose overrides this URL and uses the hostname "mongo".
MONGODB_URL=mongodb://localhost:27017/counterparties
MONGODB_DATABASE=counterparties
MONGODB_COLLECTION=counterparty_cards
MONGODB_SOURCE_COLLECTION=reports
MONGODB_CHAT_COLLECTION=chat_sessions
